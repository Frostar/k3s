{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Copenhagen",
  "schedule": ["before 6am"],
  "labels": ["dependencies"],
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+\\.yaml$/",
      "/core/.+\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/argocd/apps/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track chart versions pinned in helm-values headers (directory-source apps upgraded via template+apply)",
      "managerFilePatterns": [
        "/helm-values/.+\\.values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\s*\\n# chart-version: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Track k3s version pinned in system-upgrade-controller Plans",
      "managerFilePatterns": [
        "/core/system-upgrade-controller/(server|agent)-plan\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "k3s upgrades get their own PR per minor version so we can roll out one minor at a time",
      "matchPackageNames": ["k3s-io/k3s"],
      "matchDatasources": ["github-releases"],
      "groupName": "k3s",
      "labels": ["dependencies", "k3s-upgrade"],
      "separateMultipleMinor": true
    },
    {
      "description": "Group all non-major updates together",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchPackageNames": ["!k3s-io/k3s"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    },
    {
      "description": "Renovate bumps itself almost daily — automerge minor/patch straight to main (no PR). No CI checks exist, hence ignoreTests; the Uptime Kuma heartbeat flags a broken release",
      "matchDepNames": ["docker.io/renovate/renovate"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "renovate",
      "groupSlug": "renovate",
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Require manual approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Pin digests for all images",
      "matchManagers": ["kubernetes"],
      "pinDigests": false
    },
    {
      "description": "Wiki.js 2.x supports only Elasticsearch 6.x/7.x — stay on the 7.x line (8.x breaks the search client)",
      "matchPackageNames": ["docker.elastic.co/elasticsearch/elasticsearch"],
      "allowedVersions": "<8"
    },
    {
      "description": "Longhorn requires sequential minor upgrades — one PR per minor, applied manually (template+apply)",
      "matchDepNames": ["longhorn"],
      "matchDatasources": ["helm"],
      "groupName": "longhorn",
      "separateMultipleMinor": true,
      "labels": ["dependencies", "manual-apply"]
    },
    {
      "description": "kube-prometheus-stack is a directory-source app — merging is not enough, needs manual template+apply",
      "matchDepNames": ["kube-prometheus-stack"],
      "matchDatasources": ["helm"],
      "groupName": "kube-prometheus-stack",
      "labels": ["dependencies", "manual-apply"]
    }
  ],
  "dependencyDashboard": true
}
