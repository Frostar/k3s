{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push)",
            "command": "bash .claude/hooks/pre-push-security-check.sh",
            "timeout": 30,
            "statusMessage": "Running security checks..."
          }
        ]
      }
    ]
  }
}
